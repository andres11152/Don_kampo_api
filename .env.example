# ====================================
# Don Kampo API - Environment Variables
# ====================================
# Instrucciones:
# 1. Copia este archivo a .env
# 2. Llena todos los valores
# 3. NUNCA subas el archivo .env a Git
# ====================================

# ====================================
# NODE ENVIRONMENT
# ====================================
NODE_ENV=development
# Opciones: development | production | test

# ====================================
# SERVER CONFIGURATION
# ====================================
PORT=8080

# ====================================
# DATABASE CONFIGURATION
# ====================================
# Opción 1: Usar DATABASE_URL (recomendado para producción/Render)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Opción 2: Usar configuración individual (recomendado para desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=don_kampo_db

# ====================================
# JWT AUTHENTICATION
# ====================================
# IMPORTANTE: En producción, usar una clave de al menos 32 caracteres aleatorios
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=4b8f0c2e9a7d15b3e6c8f9a2d4b5c7e1f3a9d2b8c6e4f0a1d3b5c7e9f2a4d6b8

# ====================================
# AWS S3 CONFIGURATION
# ====================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-2
AWS_BUCKET_NAME=myawsbucket-donkampo

# ====================================
# EMAIL CONFIGURATION (Nodemailer)
# ====================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
# IMPORTANTE: Este es el email y App Password actual de Don Kampo
EMAIL_USER=donkampo76@gmail.com
EMAIL_PASSWORD=rvoe qmdk eblb tvly
EMAIL_FROM="Don Kampo <donkampo76@gmail.com>"

# ====================================
# CORS CONFIGURATION
# ====================================
# Orígenes permitidos separados por coma (sin espacios)
# Desarrollo local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Para producción, usar:
# CORS_ORIGINS=https://donkampo.com,https://www.donkampo.com

# ====================================
# RATE LIMITING (Opcional)
# ====================================
RATE_LIMIT_WINDOW_MS=900000
# 15 minutos en milisegundos
RATE_LIMIT_MAX_REQUESTS=100
# Máximo de requests por ventana

# ====================================
# LOGGING (Opcional)
# ====================================
LOG_LEVEL=info
# Opciones: error | warn | info | http | verbose | debug | silly

# ====================================
# DEFAULT VALUES / FALLBACKS
# ====================================
# URLs de imágenes por defecto cuando no se proporciona una
DEFAULT_PRODUCT_IMAGE=https://www.donkampo.com/images/default-product.jpg
DEFAULT_ADVERTISEMENT_IMAGE=https://www.donkampo.com/images/1.png

# Valores por defecto de la aplicación (en pesos colombianos)
DEFAULT_MINIMUM_ORDER=50000
DEFAULT_SHIPPING_COST=5000
